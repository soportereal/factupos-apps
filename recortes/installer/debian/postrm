#!/bin/sh
set -e

F=/usr/share/applications/org.flameshot.Flameshot.desktop

case "$1" in
    remove|purge)
        # Devuelve el lanzador de flameshot a su lugar.
        dpkg-divert --package factupos-recortes \
            --divert "$F.factupos-oculto" --rename --remove "$F" >/dev/null || true
        if command -v dconf >/dev/null 2>&1; then
            dconf update || true
        fi
        update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
        ;;
esac

exit 0
